## Copy this file to .env. The active values match the CLI defaults.
## Uncomment optional settings below only when you need to change them.

## Connection
BERCON_ADDRESS=127.0.0.1
BERCON_PORT=2305
# BERCON_PASSWORD=replace-me
BERCON_TIMEOUT=3s
BERCON_ATTEMPTS=1
BERCON_KEEPALIVE=30s

## Configuration and output
# BERCON_CONFIG=bercon-cli.ini
# BERCON_PROFILE=dayz-local
BERCON_FORMAT=table

## GeoIP
# BERCON_GEO_DB=GeoLite2-City.mmdb
# BERCON_GEO_DB_URL=https://git.io/GeoLite2-City.mmdb
# BERCON_GEO_DB_URL_AUTH=ACCOUNT_ID:LICENSE_KEY

## Exec command
# BERCON_REPEAT=1
# BERCON_SLEEP_CMD=1ms
# BERCON_SLEEP_LOOP=5s

## Shell and watch commands
# BERCON_NO_BUILTINS=true
# BERCON_TIMESTAMPS=true
